[submodule "easysync-cleanroom"]
	path = references/easysync-cleanroom
	url = https://gitlab.com/brlin/easysync-cleanroom.git
	shallow = true
	ignore = dirty
[submodule "references/oti2208-net"]
	path = references/oti2208-net
	url = https://github.com/merbanan/oti2208-net.git
	shallow = true
	ignore = dirty
