[submodule "easysync-cleanroom"]
	path = references/easysync-cleanroom
	url = https://gitlab.com/brlin/easysync-cleanroom.git
	shallow = true
	ignore = dirty
[submodule "references/oti2208-net"]
	path = references/oti2208-net
	url = https://github.com/merbanan/oti2208-net.git
	shallow = true
	ignore = dirty
[submodule "The searching-ubuntu-packages agent skill"]
	path = .agents/skills/searching-ubuntu-packages
	url = https://gitlab.com/brlin/searching-ubuntu-packages.git
	ignore = dirty
	shallow = true
[submodule "The developing-bash-scripts agent skill"]
	path = .agents/skills/developing-bash-scripts
	url = https://gitlab.com/brlin/developing-bash-scripts.git
	ignore = dirty
	shallow = true
[submodule "The determining-git-commit-messages agent skill"]
	path = .agents/skills/determining-git-commit-messages
	url = https://gitlab.com/brlin/determining-git-commit-messages.git
	ignore = dirty
	shallow = true
[submodule "The ensuring-human-in-the-loop agent skill"]
	path = .agents/skills/ensuring-human-in-the-loop
